# Copier ce fichier en ".env" puis adapter les valeurs (toutes sont facultatives).

# Compte administrateur créé au premier démarrage, s'il n'existe encore aucun administrateur.
# Sans ADMIN_PASSWORD, un mot de passe provisoire est généré : il s'affiche dans le journal du serveur
# (et dans demarrer.bat) et doit être changé à la première connexion.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Une session reste ouverte tant qu'elle sert au moins une fois tous les N jours.
SESSION_DAYS=30

# Format des codes-barres : préfixe (lettres sans A, Q, Z, W, M) + nombre de chiffres
CODE_PREFIX=ROL
CODE_DIGITS=6

# Une double lecture accidentelle du même roller dans ce délai (secondes) est ignorée. 0 = désactivé.
DUPLICATE_WINDOW_SECONDS=2

# Un roller rescanné moins de N heures après son dernier départ ou retour demande une confirmation.
# 0 = pas de confirmation.
RESCAN_CONFIRM_HOURS=24

# Nombre de jours en transit au-delà duquel un roller est signalé "en retard"
OVERDUE_DAYS=14
